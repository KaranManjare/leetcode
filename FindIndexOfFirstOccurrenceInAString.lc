//brute force :(
class Solution {
    public int strStr(String s, String w) {
        for (int i = 0; i < s.length(); i++) {
            if (s.charAt(i) == w.charAt(0)) {
                int j = i;
                int k = 0;
                while (j < s.length() && k < w.length() && s.charAt(j) == w.charAt(k)) {
                    k++;
                    j++;
                }
                if (k == w.length()) {
                    return i;
                }
            }
        }
        return -1;
    }
}
